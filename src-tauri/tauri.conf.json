{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reks",
  "version": "0.1.0",
  "identifier": "org.reks.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "reks",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../crates/reks-analysis/models/beat_this_small.onnx": "models/beat_this_small.onnx",
      "../crates/reks-analysis/models/mel_spectrogram.onnx": "models/mel_spectrogram.onnx",
      "../crates/reks-analysis/models/LICENSE-beat-this.txt": "models/LICENSE-beat-this.txt"
    }
  }
}
