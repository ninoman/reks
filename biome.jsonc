{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // UI code only; Rust is formatted by rustfmt. `.claude/` holds agent worktrees.
    // docs/wireframes, docs/research/wireframes: standalone wireframe pages published as
    // artifacts, not app code.
    "includes": [
      "**",
      "!**/.claude",
      "!**/docs/wireframes",
      "!**/docs/research/wireframes",
      "!**/src-tauri",
      "!**/crates",
      "!**/fixtures",
      "!**/target",
      "!**/dist",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "a11y": {
        // `ui/Checkbox` renders a native checkbox, so a <label> around it names it.
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox"] }
        }
      },
      "style": {
        // Was react-refresh/only-export-components: keeps Vite fast refresh working.
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": { "allowConstantExport": true }
        }
      }
    }
  },
  // Tailwind v4 at-rules (@theme, @custom-variant) in src/styles.
  "css": { "parser": { "tailwindDirectives": true } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      // Base components export their cva variants next to the component so they
      // compose (docs/ui.md). Cost: editing one of these files reloads the page
      // instead of hot-swapping it.
      "includes": ["src/components/ui/**"],
      "linter": { "rules": { "style": { "useComponentExportOnlyModules": "off" } } }
    },
    {
      // The track table is a virtualised ARIA grid built from divs: the container
      // holds focus and moves it between rows with the keyboard (WAI-ARIA grid
      // pattern), and <table> can't be absolutely positioned per row.
      "includes": ["src/components/TrackTable.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    },
    {
      // The playlist, device and history trees follow the WAI-ARIA tree pattern the
      // same way: the role="tree" container holds focus and handles the keys for its rows.
      "includes": [
        "src/components/PlaylistTree.tsx",
        "src/components/DeviceTree.tsx",
        "src/components/HistoryTree.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}
